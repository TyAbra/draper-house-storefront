# Copy to .env.local and fill in values
# Never commit .env.local to git

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/draper_house

# ── Admin login ───────────────────────────────────────────────────────────────
# Password used on the /login screen
APP_LOGIN_PASSWORD=

# Token used by API routes to authenticate internal admin calls (keep long + random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Session security ──────────────────────────────────────────────────────────
# Used to sign session cookies with HMAC-SHA256. Must be 32+ characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Stripe (Phase 3 — leave blank until checkout is enabled) ──────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── S3 Image Storage ──────────────────────────────────────────────────────────
# Required for production image uploads. Omit all four to use local filesystem (dev only).
# Install SDK before use: npm install @aws-sdk/client-s3
# IAM policy needed: s3:PutObject on arn:aws:s3:::YOUR_BUCKET/uploads/*
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
